{
  "name": "slipway",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "create": "node scripts/create-project.mjs",
    "parts": "node scripts/pack.mjs",
    "pack:check": "node scripts/pack.mjs check",
    "sync:mono": "node scripts/sync-mono.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "pnpm pack:check && pnpm test && pnpm --dir templates/mono verify && pnpm --dir templates/mono/apps/web parts:verify"
  }
}
