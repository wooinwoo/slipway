{
  "name": "slipway-astro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\"",
    "e2e": "playwright test",
    "shots": "pnpm build && node scripts/ui.mjs shots",
    "check:ui": "node scripts/ui.mjs check",
    "check:score": "npx --yes @lhci/cli@0.16.0 autorun --config=lighthouserc.cjs",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "verify": "pnpm typecheck && pnpm build && pnpm e2e && pnpm check:ui"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.2"
  }
}
