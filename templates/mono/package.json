{
  "name": "slipway-mono",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo dev",
    "dev:demo": "turbo dev:demo --filter=@slipway/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test test:e2e",
    "verify": "turbo verify",
    "build:web": "turbo build --filter=@slipway/web",
    "build:api": "turbo build --filter=@slipway/api",
    "shots": "pnpm --filter @slipway/web shots",
    "design:compare": "pnpm --filter @slipway/web design:compare",
    "preview:demo": "pnpm --filter @slipway/web preview:demo",
    "audit:deps": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
