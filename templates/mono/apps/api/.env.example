# Copy to .env. Every value is optional; defaults run a local demo with no setup.

# PORT=3000
# Unset: embedded Postgres (PGlite) in ./.data. Set for a real database:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/slipway

# Web app origin(s) for CORS and the OAuth return address, comma-separated.
# WEB_URL=http://localhost:5173
# This API's public origin, used in OAuth redirect URIs.
# API_URL=http://localhost:3000

# ALLOW_GUEST=true
# DEMO=true

# Kakao: developers.kakao.com > 앱 > 카카오 로그인. Redirect URI: ${API_URL}/api/auth/kakao/callback
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# Naver: developers.naver.com > 애플리케이션. Callback URL: ${API_URL}/api/auth/naver/callback
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
