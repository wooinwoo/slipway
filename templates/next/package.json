{
  "name": "slipway-next",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "shots": "pnpm build && node scripts/ui.mjs shots",
    "design:compare": "pnpm build && node scripts/ui.mjs compare",
    "check:ui": "node scripts/ui.mjs check",
    "check:score": "npx --yes @lhci/cli@0.16.0 autorun --config=lighthouserc.cjs",
    "audit:deps": "pnpm audit --prod --audit-level high",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:bundle && pnpm e2e && pnpm check:ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.17.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
